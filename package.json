{
	"name": "obsidian-long-sentence-highlighter",
	"version": "1.1.0",
	"description": "Obsidian plugin that highlights sentences exceeding a configurable word count threshold to improve writing clarity",
	"scripts": {
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && npm run copy-assets",
		"copy-assets": "cp src/styles.css styles.css",
		"dev": "node esbuild.config.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint src --ext .ts",
		"lint:fix": "eslint src --ext .ts --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"prepare": "husky",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"writing",
		"clarity",
		"sentences",
		"highlighting",
		"readability"
	],
	"author": "RobertMeissner",
	"license": "MIT",
	"nano-staged": {
		"*.{js,ts,json,md,yml,yaml}": [
			"prettier --write"
		],
		"*.{js,ts}": [
			"eslint --fix"
		]
	},
	"dependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.10.1",
		"@typescript-eslint/eslint-plugin": "^8.73.0",
		"@typescript-eslint/parser": "^8.73.0",
		"esbuild": "^0.28.2",
		"eslint": "^8.57.1",
		"husky": "^9.1.7",
		"jest": "^30.5.2",
		"jest-environment-obsidian": "^0.0.1",
		"nano-staged": "^1.0.2",
		"obsidian": "latest",
		"prettier": "^3.10.1",
		"ts-jest": "^29.4.15",
		"tslib": "^2.9.1",
		"typescript": "^5.9.3"
	}
}
